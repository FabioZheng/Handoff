.venv/
.venv-wsl/
__pycache__/
*.pyc
*.tmp
*.part

# Large + regenerable. The cache is worth keeping locally (reruns are free)
# but not worth committing.
cache/
data/raw/

# Committed on purpose so runs are reproducible:
#   data/sampled_ids.json
#   data/filtered_questions.jsonl
.idea/

# Personal research profile and the Obsidian vault generated from it. Kept
# locally, never published — they describe the author rather than the probe.
research/
obsidian/
.obsidian/

# Runner stdout/stderr. These embed absolute local paths and are pure console
# noise — the analysable output lives in the jsonl/csv artifacts beside them.
runs/**/*.stdout.log
runs/**/*.stderr.log
runs/**/*.log
runs/**/*.err.log
logs/
