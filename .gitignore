.venv/
.venv-wsl/
__pycache__/
*.pyc
*.tmp
*.part

# Large + regenerable. The cache is worth keeping locally (reruns are free)
# but not worth committing.
cache/
data/raw/

# Committed on purpose so runs are reproducible:
#   data/sampled_ids.json
#   data/filtered_questions.jsonl
.idea/

# Personal research profile and the Obsidian vault generated from it. Kept
# locally, never published — they describe the author rather than the probe.
research/
obsidian/
.obsidian/

# Runner stdout/stderr. These embed absolute local paths and are pure console
# noise — the analysable output lives in the jsonl/csv artifacts beside them.
runs/**/*.stdout.log
runs/**/*.stderr.log
runs/**/*.log
runs/**/*.err.log
logs/

# Experiment 5 on Bunya: the job venv (a symlink in some checkouts, so no
# trailing slash) and the run outputs. Analysed results live in results/exp5_*.
.venv-*
runs/exp5_cap_only/
runs/exp5_uncapped/

# Cluster launch scripts stay local; they carry scheduler and account details.
hpc/

# Machine outputs stay local: raw model outputs, and the tables behind each report.
# results/ keeps each experiment's report and figures; the runners regenerate the rest.
runs/
results/**/*.csv
results/**/*.json
results/**/*.jsonl
results/**/*.txt
results/**/*.pdf
!results/exp5_cap_only/calibration/mistral24/calibration.json

# Internal audit notes stay local.
results/exp5_prompt_family/JOB_AUDIT.md
